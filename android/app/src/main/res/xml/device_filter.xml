<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Generic USB printer filter -->
    <!-- This allows your app to detect when a USB printer is connected -->
    <usb-device class="7" subclass="1" protocol="1" />
    <usb-device class="7" subclass="1" protocol="2" />
    <usb-device class="7" subclass="1" protocol="3" />

    <!-- Alternative: Add specific VID/PID if you know them -->
    <!-- Replace vendor-id and product-id with actual values from your printer -->
    <!-- <usb-device vendor-id="1234" product-id="5678" /> -->
</resources>